# Template of environment variables. Copy as .env (never commit the real one)
# or define the same variables in your Portainer stack. Placeholders only.

# Absolute path on the host under which the project's data lives
# (garmin-app/, grafana_data/, hermes/data/ ...)
DATA_ROOT=/home/youruser/docker

# Grafana admin password (choose your own, long and unique)
GRAFANA_PASSWORD=change-me

# Token for the optional on-demand sync webhook. Generate with: openssl rand -hex 32
SYNC_WEBHOOK_TOKEN=generate-with-openssl-rand-hex-32

# UID/GID that Hermes runs as (check yours with: id -u / id -g)
HERMES_UID=1000
HERMES_GID=1000
