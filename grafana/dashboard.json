        "spec": {
          "id": 1,
          "title": "Evolución ritmo (min/km)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "frser-sqlite-datasource",
                      "version": "v0",
                      "spec": {
                        "queryText": "SELECT\n  REPLACE(start_time_gmt, ' ', 'T') || 'Z' AS time,\n  ROUND((1000.0 / average_speed_mps) / 60.0, 2) AS \"Ritmo (min/km)\"\nFROM activities\nWHERE activity_type IN ('running', 'trail_running', 'ultra_run', 'treadmill_running')\n  AND average_speed_mps > 0\nORDER BY start_time_gmt ASC",
                        "queryType": "time series",
                        "rawQueryText": "SELECT\n  REPLACE(start_time_gmt, ' ', 'T') || 'Z' AS time,\n  ROUND((1000.0 / average_speed_mps) / 60.0, 2) AS \"Ritmo (min/km)\"\nFROM activities\nWHERE activity_type IN ('running', 'trail_running', 'ultra_run', 'treadmill_running')\n  AND average_speed_mps > 0\nORDER BY start_time_gmt ASC",
                        "timeColumns": [
                          "time",
                          "ts"
